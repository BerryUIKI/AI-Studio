# ==============================================================================
# Berry AI Studio Environment Configuration Template
# Copy this file to .env and configure values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Logging Configuration
# ------------------------------------------------------------------------------
# Port for Berry AI Studio FastAPI server (Default: 8000)
BERRY_PORT=8000

# Logging verbosity level: DEBUG, INFO, WARNING, ERROR, CRITICAL (Default: INFO)
LOG_LEVEL=INFO

# Application data directory (SQLite database, assets, project metadata)
# Defaults to OS user local data directory if not set
BERRY_DATA_DIR=./data

# Local execution engine sandboxed storage directory (ComfyUI / models)
# Defaults to OS user isolated engine directory if not set
# AI_WORKFLOW_ENGINE_DIR=

# ------------------------------------------------------------------------------
# Cloud Generative APIs (API-First Execution Mode)
# ------------------------------------------------------------------------------
# OpenAI API configuration (for GPT-4o, DALL-E 3, etc.)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com

# Fal.ai API Key (for FLUX.1 [schnell], FLUX.1 [dev], etc.)
FAL_KEY=

# SiliconFlow API Key (for DeepSeek, Flux, Qwen, Wan video, etc.)
SILICONFLOW_API_KEY=

# Primary LLM API configuration (Default base URL: https://api.deepseek.com)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# Fallback Cloud Image Generation API Key (if not using provider-specific keys)
IMAGE_API_KEY=

# ------------------------------------------------------------------------------
# Optional Local Engine Integrations
# ------------------------------------------------------------------------------
# ComfyUI Host & Port (Default: 127.0.0.1:8188)
COMFYUI_HOST=127.0.0.1:8188

# Embedded llama-server Port (Default: 8080)
LLAMA_SERVER_PORT=8080
